            "url": "https://dev.blues.io/quickstart/starnote-quickstart/"
        },
        {
            "title": "Updating Starnote for Skylo Firmware",
            "url": "https://dev.blues.io/starnote/starnote-for-skylo/updating-starnote-for-skylo-firmware#verifying-success-of-a-starnote-firmware-update"
        },
        {
            "title": "Diagnosing Satellite Connectivity Issues",
            "url": "https://dev.blues.io/support/diagnosing-satellite-connectivity-issues"
        }
    ]
}
