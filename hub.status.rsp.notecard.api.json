{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/blues/notecard-schema/master/hub.status.rsp.notecard.api.json",
    "title": "hub.status Response Application Programming Interface (API) Schema",
    "description": "Response containing the current status of the Notecard's connection to Notehub.",
    "type": "object",
    "version": "1.1.2",
    "apiVersion": "9.1.1",
    "skus": [
        "CELL",
        "CELL+WIFI",
        "LORA",
        "WIFI"
    ],
    "properties": {
        "connected": {
            "description": "`true` if the Notecard is connected to Notehub.",
            "type": "boolean"
        },
        "err": {
            "description": "If present, a string describing a connection or authentication error, e.g. `{\"err\":\"unable to connect to notehub {notehub-open-failure}\"}`.",
            "type": "string",
            "codeRef": [
                "notecard.error.json#/$defs/auth",
                "notecard.error.json#/$defs/auth-retry",
                "notecard.error.json#/$defs/connect-aborted",
                "notecard.error.json#/$defs/device-delay-5",
                "notecard.error.json#/$defs/device-disabled",
                "notecard.error.json#/$defs/extended-network-failure",
                "notecard.error.json#/$defs/extended-service-failure",
                "notecard.error.json#/$defs/host-unreachable",
                "notecard.error.json#/$defs/hub-not-connected",
                "notecard.error.json#/$defs/network",
                "notecard.error.json#/$defs/network-timeout",
                "notecard.error.json#/$defs/notehub-open-failure",
                "notecard.error.json#/$defs/product-noexist",
                "notecard.error.json#/$defs/request-failure",
                "notecard.error.json#/$defs/service",
                "notecard.error.json#/$defs/session-closed",
                "notecard.error.json#/$defs/ticket",
                "notecard.error.json#/$defs/transport-unreachable",
                "notecard.error.json#/$defs/web-payload"
            ]
        },
        "status": {
            "description": "Details about the Notecard's transport (e.g. cellular, WiFi, LoRa) connection status.\n\nUse `connected` to check if the Notecard is connected to Notehub.",
            "type": "string",
            "codeRef": [
                "notecard.status.json#/$defs/auth",
                "notecard.status.json#/$defs/auth-retry",
                "notecard.status.json#/$defs/connect-aborted",
                "notecard.status.json#/$defs/connected",
                "notecard.status.json#/$defs/device-delay-5",
                "notecard.status.json#/$defs/device-disabled",
                "notecard.status.json#/$defs/disconnected",
                "notecard.status.json#/$defs/extended-network-failure",
                "notecard.status.json#/$defs/extended-service-failure",
                "notecard.status.json#/$defs/host-retry",
                "notecard.status.json#/$defs/host-unreachable",
                "notecard.status.json#/$defs/hub-not-connected",
                "notecard.status.json#/$defs/net-init",
                "notecard.status.json#/$defs/network",
                "notecard.status.json#/$defs/network-timeout",
                "notecard.status.json#/$defs/no-changes",
                "notecard.status.json#/$defs/not-connected",
                "notecard.status.json#/$defs/notehub-connected",
                "notecard.status.json#/$defs/notehub-disconnected",
                "notecard.status.json#/$defs/notehub-open-failure",
                "notecard.status.json#/$defs/product-noexist",
                "notecard.status.json#/$defs/request-failure",
                "notecard.status.json#/$defs/service",
                "notecard.status.json#/$defs/session-closed",
                "notecard.status.json#/$defs/socket-ip-init",
                "notecard.status.json#/$defs/socket-ip-term",
                "notecard.status.json#/$defs/ticket",
                "notecard.status.json#/$defs/transport-unreachable",
                "notecard.status.json#/$defs/wait-data",
                "notecard.status.json#/$defs/wait-gateway",
                "notecard.status.json#/$defs/wait-service",
                "notecard.status.json#/$defs/web-payload"
            ]
        }
    },
    "required": [
        "status"
    ],
    "unevaluatedProperties": false,
    "samples": [
        {
            "title": "Connected Status",
            "description": "Response when Notecard is connected to Notehub.",
            "json": "{\"status\": \"connected (session open) {connected}\", \"connected\": true}"
        },
        {
            "title": "Disconnected Status",
            "description": "Response when Notecard is not connected to Notehub.",
            "json": "{\"status\": \"disconnected\"}"
        }
    ]
}
