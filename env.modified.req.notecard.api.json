{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/blues/notecard-schema/master/env.modified.req.notecard.api.json",
    "title": "env.modified Request Application Programming Interface (API) Schema",
    "description": "Get the time of the update to any environment variable managed by the Notecard.",
    "type": "object",
    "version": "1.1.2",
    "apiVersion": "9.1.1",
    "skus": [
        "CELL",
        "CELL+WIFI",
        "LORA",
        "SKYLO",
        "WIFI"
    ],
    "properties": {
        "time": {
            "description": "The `time` from a previous `env.modified` or `env.get` response. If no environment variable has changed since then, the request returns an `{env-not-modified}` error instead of a new `time`.",
            "type": "integer",
            "minApiVersion": "3.4.1",
            "skus": [
                "CELL",
                "CELL+WIFI",
                "SKYLO",
                "WIFI"
            ]
        },
        "req": {
            "description": "Request for the Notecard (expects response)",
            "const": "env.modified"
        },
        "cmd": {
            "description": "Command for the Notecard (no response)",
            "const": "env.modified"
        }
    },
    "oneOf": [
        {
            "required": [
                "req"
            ],
            "properties": {
                "req": {
                    "const": "env.modified"
                }
            }
        },
        {
            "required": [
                "cmd"
            ],
            "properties": {
                "cmd": {
                    "const": "env.modified"
                }
            }
        }
    ],
    "unevaluatedProperties": false,
    "samples": [
        {
            "title": "Get Environment Modified Time",
            "description": "Get the timestamp of the last environment variable change.",
            "json": "{\"req\": \"env.modified\"}"
        },
        {
            "title": "Check Changes Since Time",
            "description": "Check if environment variables have been modified since a specific time.",
            "json": "{\"req\": \"env.modified\", \"time\": 1605814400}"
        }
    ],
    "links": [
        {
            "title": "Checking for Environment Variable Changes",
            "url": "https://dev.blues.io/notecard/notecard-walkthrough/essential-requests/#checking-for-environment-variable-changes"
        }
    ]
}
